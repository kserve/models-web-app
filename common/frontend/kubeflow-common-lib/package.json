{
  "name": "angular-frontend-kubeflow",
  "version": "0.0.0",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run copyCSS && npm run copyAssets",
    "test": "ng test",
    "test-ci": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI",
    "test-docker": "docker run -v $(pwd):/usr/src/app browserless/chrome:1.44-chrome-stable npm run test-ci",
    "test:prod": "ng test --browsers=ChromeHeadless --watch=false",
    "lint-check": "ng lint",
    "lint": "ng lint --fix",
    "e2e": "ng e2e",
    "copyCSS": "cp -r ./projects/kubeflow/src/styles ./dist/kubeflow/styles",
    "copyAssets": "cp -r ./projects/kubeflow/src/assets ./dist/kubeflow/assets",
    "format:check": "prettier --check 'projects/kubeflow/src/**/*.{js,ts,html,scss,css}' || node scripts/check-format-error.js",
    "format:write": "prettier --write 'projects/kubeflow/src/**/*.{js,ts,html,scss,css}'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~22.2.3",
    "@angular/cdk": "~22.2.3",
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/localize": "~22.2.3",
    "@angular/material": "~22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "@angular/platform-browser-dynamic": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@fortawesome/angular-fontawesome": "~5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "date-fns": "1.29.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "material-icons": "^0.7.7",
    "monaco-editor": "^0.33.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.2.2",
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "~22.2.3",
    "@angular/language-service": "~22.2.3",
    "@eslint/js": "^9.39.0",
    "@kubernetes/client-node": "^0.16.3",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.17.6",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^26.0.0",
    "angular-eslint": "~22.6.0",
    "eslint": "^9.39.0",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "~22.2.4",
    "prettier": "2.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}

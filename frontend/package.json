{
  "name": "kserve-models-web-app",
  "version": "1.1.0",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "format": "prettier --write './**/*.{ts,html,css}'",
    "build": "npm run copyCSS && npm run copyLibAssets && ng build --configuration production --deploy-url static/",
    "build:fr": "npm run copyCSS && npm run copyLibAssets && ng build --configuration fr --deploy-url static/",
    "build:watch": "npm run copyCSS && npm run copyLibAssets && ng build --configuration production --watch --deploy-url static/ --output-path ../backend/apps/v1beta1/static/ --output-hashing all",
    "build:watch:fr": "npm run copyCSS && npm run copyLibAssets && ng build --configuration fr --watch --deploy-url static/ --output-path ../backend/apps/v1beta1/static/ --output-hashing all",
    "build:watch:ng": "npm run copyCSS && npm run copyLibAssets && ng serve --proxy-config proxy.conf.json",
    "serve:simple": "ng serve --host 0.0.0.0 --port 4200",
    "serve:test": "ng serve --port 4200",
    "copyCSS": "rm -rf ./src/styles && mkdir -p ./src/styles && cp -r ./node_modules/kubeflow/styles/* ./src/styles/",
    "copyLibAssets": "rm -rf ./src/assets/fonts && mkdir -p ./src/assets && cp -r ./node_modules/kubeflow/assets/* ./src/assets/",
    "format:check": "prettier --check 'src/**/*.{js,ts,html,scss,css}' || node scripts/check-format-error.js",
    "format:write": "prettier --write 'src/**/*.{js,ts,html,scss,css}'",
    "i18n:extract": "ng extract-i18n --output-path i18n",
    "test": "jest",
    "test:jest": "jest",
    "test:prod": "jest --ci --coverage",
    "lint-check": "ng lint",
    "lint": "ng lint --fix",
    "e2e": "npm run e2e:cypress:ci",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headless": "cypress run --headless",
    "e2e:cypress": "concurrently \"npm run build:watch:ng\" \"cypress open\" --kill-others --success first",
    "e2e:cypress:ci": "concurrently \"npm run build:watch:ng\" \"wait-on http://localhost:4200 && cypress run\" --kill-others --success first"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~22.2.3",
    "@angular/cdk": "~22.2.3",
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/localize": "~22.2.3",
    "@angular/material": "~22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "@angular/platform-browser-dynamic": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@fortawesome/angular-fontawesome": "~5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@kubernetes/client-node": "^0.17.0",
    "ace-builds": "^1.40.0",
    "date-fns": "^1.29.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "material-icons": "^1.10.8",
    "monaco-editor": "^0.33.0",
    "ngx-ace-wrapper": "^17.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.2.2",
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "~22.2.3",
    "@angular/language-service": "~22.2.3",
    "@cypress/webpack-dev-server": "^6.1.0",
    "@testing-library/cypress": "^10.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "angular-eslint": "~22.6.0",
    "concurrently": "^9.1.2",
    "cypress": "^15.21.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "jest-preset-angular": "~17.0.3",
    "jsdom": "^26.1.0",
    "prettier": "^2.8.8",
    "ts-node": "~10.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "cypress": true
  }
}
